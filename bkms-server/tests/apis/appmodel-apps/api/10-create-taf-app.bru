meta {
  name: 10-create-taf-app
  type: http
  seq: 10
}

post {
  url: {{serviceURL}}/workspaces/{{bkmsAppWorkspaceID}}/appmodel-apps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{bkmsAppTafID}}",
    "id": "{{bkmsAppTafID}}",
    "framework": "taf",
    "language": "cpp",
    "appModelSpec": {"command": ["sleep"], "args": ["3600"]},
    "frameworkConfigFile": {"name": "app.conf", "mountDir": "/usr/local/app/conf"},
    "buildConfig": {"sourceType": "imageRegistry", "imageBuildConfig": {"name": "app"}}
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should create a bkmsApp with the taf framework", () => {
    expect(res.body.data.type).to.equal("bkmsApp");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
