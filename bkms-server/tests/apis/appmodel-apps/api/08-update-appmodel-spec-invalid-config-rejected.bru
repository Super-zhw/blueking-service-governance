meta {
  name: 08-update-appmodel-spec-invalid-config-rejected
  type: http
  seq: 8
}

put {
  url: {{serviceURL}}/apps/{{bkmsAppBlankID}}/appmodel-spec
  body: json
  auth: inherit
}

body:json {
  {
    "shCommand": "sleep 7200",
    "frameworkConfig": {"fileName": "app.yaml"}
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject unknown frameworkConfig keys", () => {
    expect(JSON.stringify(res.body)).to.include("invalid keys: fileName");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
