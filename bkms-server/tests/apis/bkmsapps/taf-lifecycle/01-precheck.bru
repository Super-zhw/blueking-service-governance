meta {
  name: 01-precheck
  type: http
  seq: 1
}

get {
  url: {{serviceURL}}/apps/{{tafLcAppID}}/envs/{{tafLcEnvName}}/bkmsapp-deploys/precheck
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should pass the deploy pre-check through the bkmsapp-deploys API", () => {
    expect(res.body.data).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 30000
}
