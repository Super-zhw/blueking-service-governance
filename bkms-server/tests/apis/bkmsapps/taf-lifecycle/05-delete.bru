meta {
  name: 05-delete
  type: http
  seq: 5
}

delete {
  url: {{serviceURL}}/apps/{{tafLcAppID}}/envs/{{tafLcEnvName}}/bkmsapp-deploys
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  if (res.status !== 200) {
    return;
  }
  const appmodel = require("./helpers/appmodel");
  const record = await appmodel.waitForAppModelDeployTerminal({
    kind: "bkmsapp",
    appID: bru.getVar("tafLcAppID"),
    envName: bru.getVar("tafLcEnvName"),
    expectedStatus: "uninstalled",
    imageTag: bru.getVar("tafLcImageTag")
  });
  bru.setVar("tafLcUninstalledStatus", record.status);
}

tests {
  test("should uninstall the taf app", () => {
    expect(bru.getVar("tafLcUninstalledStatus")).to.equal("uninstalled");
  });
}

settings {
  encodeUrl: true
  timeout: 130000
}
