meta {
  name: 02-create-blank-with-framework-file-rejected
  type: http
  seq: 2
}

post {
  url: {{serviceURL}}/workspaces/{{bkmsAppWorkspaceID}}/bkmsapps
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{bkmsAppBlankID}}",
    "id": "{{bkmsAppBlankID}}",
    "framework": "blank",
    "language": "go",
    "appModelSpec": {"command": ["sleep"], "args": ["3600"]},
    "frameworkConfigFile": {"name": "app.yaml", "mountDir": "/etc/app"},
    "buildConfig": {"sourceType": "imageRegistry", "imageBuildConfig": {"name": "app"}}
  }
}

assert {
  res.status: eq 400
  res.body: isJson
}

tests {
  test("should reject a framework config file for blank", () => {
    expect(JSON.stringify(res.body)).to.include("does not support framework config file");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
