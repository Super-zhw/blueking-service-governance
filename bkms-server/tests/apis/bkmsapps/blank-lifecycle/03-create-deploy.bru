meta {
  name: 03-create-deploy
  type: http
  seq: 3
}

post {
  url: {{serviceURL}}/apps/{{blankLcAppID}}/envs/{{blankLcEnvName}}/bkmsapp-deploys
  body: json
  auth: inherit
}

body:json {
  {
    "imageTag": "{{blankLcImageTag}}",
    "replicas": 1
  }
}

assert {
  res.status: eq 200
  res.body: isJson
}

script:post-response {
  if (res.status !== 200) {
    return;
  }
  const appmodel = require("./helpers/appmodel");
  const record = await appmodel.waitForAppModelDeployTerminal({
    kind: "bkmsapp",
    appID: bru.getVar("blankLcAppID"),
    envName: bru.getVar("blankLcEnvName"),
    expectedStatus: "deployed",
    imageTag: bru.getVar("blankLcImageTag")
  });
  bru.setVar("blankLcDeployID", record.id);
  bru.setVar("blankLcDeployStatus", record.status);
}

tests {
  test("should deploy the blank app and converge to deployed", () => {
    expect(bru.getVar("blankLcDeployID")).to.be.a("string").and.not.empty;
    expect(bru.getVar("blankLcDeployStatus")).to.equal("deployed");
  });
}

settings {
  encodeUrl: true
  timeout: 130000
}
