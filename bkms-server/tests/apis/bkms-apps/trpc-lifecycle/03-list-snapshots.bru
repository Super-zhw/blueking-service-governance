meta {
  name: 03-list-snapshots
  type: http
  seq: 3
}

get {
  url: {{serviceURL}}/apps/{{trpcLcAppID}}/envs/{{trpcLcEnvName}}/bkms-deploys/{{trpcLcDeployID}}/resource-snapshots?page=1&pageSize=20
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isJson
}

tests {
  test("should render a GameDeployment workload", () => {
    const kinds = res.body.data.results.map((row) => row.kind);
    expect(kinds, JSON.stringify(kinds)).to.include("GameDeployment");
  });
}

settings {
  encodeUrl: true
  timeout: 10000
}
